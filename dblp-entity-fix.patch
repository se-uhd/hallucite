+
+/// Insert or update a publication with the record metadata the dump carries alongside the title.
+///
+/// `year`, `venue` and `ee` are what a citation is checked against beyond its title and authors:
+/// without them a wrong year or venue, or a DOI belonging to another work, cannot be seen offline
+/// at all. `kind` (the DBLP element: "article", "inproceedings", "book", ...) separates a book from
+/// an article of the same name, which authors alone cannot always do.
+#[allow(clippy::too_many_arguments)]
+pub fn insert_or_get_publication_full(
+    conn: &Connection,
+    key: &str,
+    title: &str,
+    year: Option<i32>,
+    venue: Option<&str>,
+    ee: Option<&str>,
+    kind: &str,
+) -> Result<i64, DblpError> {
+    let mut stmt = conn.prepare_cached(
+        "INSERT INTO publications (key, title, year, venue, ee, kind) \
+         VALUES (?1, ?2, ?3, ?4, ?5, ?6) \
+         ON CONFLICT(key) DO UPDATE SET title = excluded.title, year = excluded.year, \
+         venue = excluded.venue, ee = excluded.ee, kind = excluded.kind RETURNING id",
     )?;
-    let id: i64 = stmt.query_row(params![key, title], |row| row.get(0))?;
+    let id: i64 = stmt.query_row(params![key, title, year, venue, ee, kind], |row| row.get(0))?;
     Ok(id)
 }
 
