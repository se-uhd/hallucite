+
+/// Build the offline DBLP database from a dump already on disk.
+///
+/// dblp.org and its mirrors front `dblp.xml.gz` with an interactive proof-of-work bot check. A
+/// plain HTTP client gets the challenge page instead of the dump, parses zero publications out of
+/// it, and `update-dblp` still exits 0 -- so a working mirror is silently replaced by an empty
+/// one. Downloading the dump in a browser and ingesting it here is the way through that.
+fn build_dblp_from_file(db_path: &PathBuf, xml_gz: &std::path::Path) -> anyhow::Result<()> {
+    use indicatif::{HumanCount, ProgressBar, ProgressStyle};
+    use std::time::Duration;
+
+    let bar = ProgressBar::new_spinner();
+    bar.set_style(ProgressStyle::with_template("{spinner:.green} [{elapsed_precise}] {msg}")?);
+    bar.enable_steady_tick(Duration::from_millis(120));
+    bar.set_message(format!("Reading {}", xml_gz.display()));
 
+    hallucinator_dblp::build_database_from_file(db_path, xml_gz, |event| match event {
+        hallucinator_dblp::BuildProgress::Parsing {
+            records_inserted, ..
+        } => bar.set_message(format!("{} publications", HumanCount(records_inserted))),
+        hallucinator_dblp::BuildProgress::RebuildingIndex => {
+            bar.set_message("Rebuilding FTS search index...")
+        }
+        hallucinator_dblp::BuildProgress::Compacting => {
+            bar.set_message("Compacting database (VACUUM)...")
+        }
+        hallucinator_dblp::BuildProgress::Complete {
+            publications,
+            authors,
+            ..
+        } => bar.finish_with_message(format!(
+            "Indexed {} publications, {} authors",
+            HumanCount(publications),
+            HumanCount(authors)
+        )),
+        hallucinator_dblp::BuildProgress::Downloading { .. } => {}
+    })?;
+
+    let canonical = std::fs::canonicalize(db_path).unwrap_or_else(|_| db_path.clone());
+    println!("DBLP database saved to: {}", canonical.display());
     Ok(())
 }
 
