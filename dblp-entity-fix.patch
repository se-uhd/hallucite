+#[cfg(test)]
+mod entity_tests {
+    use super::*;
+
+    /// DBLP writes Latin-1 letters as the named entities its DTD declares. Every author whose
+    /// name used one was dropped from the record entirely, so `journals/tse/SoaresRGAS23` kept
+    /// 3 of its 5 authors and the Wohlin book 3 of its 5.
+    #[test]
+    fn named_entities_in_author_names_survive() {
+        let xml = r#"<?xml version="1.0" encoding="UTF-8"?>
+<dblp>
+<article key="journals/tse/SoaresRGAS23" mdate="2023-03-01">
+  <author>Elvys Soares</author>
+  <author>M&aacute;rcio Ribeiro</author>
+  <author>Rohit Gheyi</author>
+  <author>Guilherme Amaral</author>
+  <author>Andr&eacute; Santos</author>
+  <title>Refactoring Test Smells With JUnit 5.</title>
+</article>
+<book key="books/sp/WohlinRHOR00" mdate="2012-01-01">
+  <author>Claes Wohlin</author>
+  <author>Per Runeson</author>
+  <author>Martin H&ouml;st</author>
+  <author>Magnus C. Ohlsson</author>
+  <author>Bj&ouml;rn Regnell</author>
+  <author>Anders Wessl&eacute;n</author>
+  <title>Experimentation in Software Engineering.</title>
+</book>
+</dblp>"#;
+        let mut pubs = Vec::new();
+        parse_xml(xml.as_bytes(), |p| pubs.push(p));
+
+        assert_eq!(pubs.len(), 2);
+        assert_eq!(
+            pubs[0].authors,
+            vec!["Elvys Soares", "Márcio Ribeiro", "Rohit Gheyi",
+                 "Guilherme Amaral", "André Santos"]
+        );
+        assert_eq!(
+            pubs[1].authors,
+            vec!["Claes Wohlin", "Per Runeson", "Martin Höst",
+                 "Magnus C. Ohlsson", "Björn Regnell", "Anders Wesslén"]
+        );
     }
 }
+
+#[cfg(test)]
+mod field_tests {
+    use super::*;
+
+    /// The dump carries year, venue and the electronic edition on every record. Storing only the
+    /// title and authors left two of the four fabrication signals -- a wrong venue/year, and a DOI
+    /// belonging to another work -- uncheckable offline, with `<ee>` parsed and then discarded.
+    #[test]
+    fn year_venue_ee_and_kind_are_extracted() {
+        let xml = r#"<?xml version="1.0" encoding="UTF-8"?>
+<dblp>
+<article key="journals/tse/SoaresRGAS23">
+  <author>Elvys Soares</author><author>M&aacute;rcio Ribeiro</author>
+  <title>Refactoring Test Smells With JUnit 5.</title>
+  <journal>IEEE Trans. Software Eng.</journal>
+  <volume>49</volume><number>3</number><pages>1152-1170</pages>
+  <year>2023</year>
+  <ee>https://doi.org/10.1109/TSE.2022.3172654</ee>
+</article>
+<inproceedings key="conf/icse/Example24">
+  <author>Anna Apple</author>
+  <title>An invented conference paper.</title>
+  <booktitle>ICSE</booktitle>
+  <year>2024</year>
+</inproceedings>
+<book key="books/sp/WohlinRHOR00">
+  <author>Claes Wohlin</author><author>Martin H&ouml;st</author>
+  <title>Experimentation in Software Engineering.</title>
+  <year>2000</year>
+</book>
+</dblp>"#;
+        let mut pubs = Vec::new();
+        parse_xml(xml.as_bytes(), |p| pubs.push(p));
+        assert_eq!(pubs.len(), 3);
+
+        assert_eq!(pubs[0].kind, "article");
+        assert_eq!(pubs[0].year, Some(2023));
+        assert_eq!(pubs[0].venue.as_deref(), Some("IEEE Trans. Software Eng."));
+        assert_eq!(
+            pubs[0].url.as_deref(),
+            Some("https://doi.org/10.1109/TSE.2022.3172654")
+        );
+        assert_eq!(pubs[0].authors, vec!["Elvys Soares", "Márcio Ribeiro"]);
+
+        // A conference record takes its venue from <booktitle>, which must close the field too.
+        assert_eq!(pubs[1].kind, "inproceedings");
+        assert_eq!(pubs[1].venue.as_deref(), Some("ICSE"));
+        assert_eq!(pubs[1].year, Some(2024));
+        assert_eq!(pubs[1].title, "An invented conference paper.");
+
+        // `kind` is what separates this from the same-titled TSE article and journal note.
+        assert_eq!(pubs[2].kind, "book");
+        assert_eq!(pubs[2].year, Some(2000));
+        assert_eq!(pubs[2].venue, None);
+        assert_eq!(pubs[2].authors, vec!["Claes Wohlin", "Martin Höst"]);
+    }
+}
