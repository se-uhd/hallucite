+                if reading.is_some() {
+                    // DBLP's dump writes Latin-1 letters as the named entities its DTD declares
+                    // (`&aacute;`, `&ouml;`). Dropping the chunk when one of those fails to resolve
+                    // silently deletes the whole author name, so the author vanishes from every
+                    // paper they wrote. Fall back to the raw bytes instead of losing the field.
+                    match e.unescape() {
+                        Ok(text) => text_buf.push_str(&text),
+                        Err(_) => text_buf.push_str(&String::from_utf8_lossy(e.as_ref())),
+                    }
                 }
